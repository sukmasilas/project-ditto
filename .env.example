DISCORD_BOT_TOKEN=
BOT_TIMEZONE=Asia/Jakarta
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_RUNAME=

# Numbered eBay accounts: orders, buyer messages, eBay system notices and
# 24h "still unreplied" @everyone reminders, all in ALERT_CHANNEL_ID. Add as
# many EBAY_ACCOUNT_N_* blocks as you have accounts, starting at 1 with no
# gaps. Each needs at least NAME, REFRESH_TOKEN, and ALERT_CHANNEL_ID to be
# active - an account missing either of those is skipped at startup (logged,
# not a crash). SELLER_USERNAME is the account's eBay username - without it
# the 24h reminders are off for that account. NAME is only an internal label
# (and the ebay_state.json key) - never rename it once in use.
EBAY_ACCOUNT_1_NAME=
EBAY_ACCOUNT_1_REFRESH_TOKEN=
EBAY_ACCOUNT_1_SELLER_USERNAME=
EBAY_ACCOUNT_1_ALERT_CHANNEL_ID=

EBAY_ACCOUNT_2_NAME=
EBAY_ACCOUNT_2_REFRESH_TOKEN=
EBAY_ACCOUNT_2_SELLER_USERNAME=
EBAY_ACCOUNT_2_ALERT_CHANNEL_ID=

# Classic Trading API (XML) fallback, for ONE specific account whose REST
# token can't carry the scopes it needs (see claude.md). Separate credential
# set on purpose - NOT the same as EBAY_APP_ID/EBAY_CERT_ID above. This one
# is SHARED with another production app on the server (Lister Tool) - see
# claude.md's gotcha before ever touching EBAY_TRADING_REFRESH_TOKEN.
# EBAY_TRADING_ACCOUNT_NAME must match one of the EBAY_ACCOUNT_N_NAME values
# above - that account's ALERT_CHANNEL_ID is reused for these notifications.
# All four must be set together for this fallback to activate.
EBAY_TRADING_CLIENT_ID=
EBAY_TRADING_CLIENT_SECRET=
EBAY_TRADING_REFRESH_TOKEN=
EBAY_TRADING_ACCOUNT_NAME=
# Optional: how often (minutes) the Trading API fallback polls. Default 10.
# Each poll is 3+ calls on the credential shared with Lister Tool - keep it
# modest (eBay returned "exceeded usage limit" errors at the old 2 minutes).
EBAY_TRADING_POLL_MINUTES=
# Optional: how often (minutes) the regular REST eBay check polls (orders,
# messages, 24h reminders). Default 10.
EBAY_POLL_MINUTES=
