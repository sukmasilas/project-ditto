DISCORD_BOT_TOKEN=
BOT_TIMEZONE=Asia/Jakarta
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_RUNAME=

# Numbered eBay accounts for the general activity feed (orders + eBay system
# notices). Add as many EBAY_ACCOUNT_N_* blocks as you have accounts, starting
# at 1 with no gaps. Each needs at least NAME, REFRESH_TOKEN, and
# ALERT_CHANNEL_ID to be active - an account missing either of those is
# skipped at startup (logged, not a crash).
#
# CUSTOMER_CHANNEL_ID is optional - only set it for the one account whose
# buyer messages should get the full customer-message thread treatment
# (root notification + thread + 24h escalation + @everyone pings). That
# feature is single-account only for now, even if multiple accounts are
# configured overall.
EBAY_ACCOUNT_1_NAME=
EBAY_ACCOUNT_1_REFRESH_TOKEN=
EBAY_ACCOUNT_1_SELLER_USERNAME=
EBAY_ACCOUNT_1_ALERT_CHANNEL_ID=
EBAY_ACCOUNT_1_CUSTOMER_CHANNEL_ID=

EBAY_ACCOUNT_2_NAME=
EBAY_ACCOUNT_2_REFRESH_TOKEN=
EBAY_ACCOUNT_2_SELLER_USERNAME=
EBAY_ACCOUNT_2_ALERT_CHANNEL_ID=
